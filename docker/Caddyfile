# Cloud deployment edge: serves the Flutter Web build and reverse-proxies
# /api/<service>/* to the internal backend containers, mirroring docker/nginx.conf's
# routing exactly (same single-origin, no-CORS design — see that file's comment).
# The one thing nginx doesn't do without extra certbot machinery: Caddy issues and
# renews a real Let's Encrypt certificate for {$SITE_ADDRESS} automatically, since
# that's a real resolvable hostname (a sslip.io name built from the server's static
# IP), not "localhost" or a bare IP literal.

{$SITE_ADDRESS} {
	encode gzip

	handle_path /api/identity-profile/* {
		reverse_proxy identity-profile:3001
	}
	handle_path /api/offer/* {
		reverse_proxy offer:3002
	}
	handle_path /api/discovery-location/* {
		reverse_proxy discovery-location:3003
	}
	handle_path /api/participation/* {
		reverse_proxy participation:3004
	}
	handle_path /api/messaging/* {
		reverse_proxy messaging:3005
	}
	handle_path /api/trust-safety/* {
		reverse_proxy trust-safety:3006
	}
	handle_path /api/entitlements-billing/* {
		reverse_proxy entitlements-billing:3007
	}
	handle_path /api/notification/* {
		reverse_proxy notification:3008
	}
	handle_path /api/media/* {
		reverse_proxy media:3009
	}

	# Flutter Web (compiled release build), same as nginx.conf's `root`/`try_files`.
	handle {
		root * /usr/share/caddy
		# Flutter's default build doesn't content-hash main.dart.js/index.html, and
		# neither Caddy nor nginx sets Cache-Control by default — so with no header
		# here, browsers apply heuristic caching (based on Last-Modified) and can go
		# on serving an old main.dart.js for a long time after a deploy without even
		# asking the server, silently undoing whatever was just shipped. Verified
		# live: a plain `fetch('/main.dart.js')` right after a fresh deploy returned
		# a week-old Last-Modified from the browser's disk cache, while the same
		# request with `cache: 'no-store'` got the just-deployed one. `no-cache`
		# forces a conditional revalidation (If-Modified-Since/If-None-Match) on
		# every load instead — cheap for a app this size, and it means a deploy is
		# never silently masked by a stale cache again.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
