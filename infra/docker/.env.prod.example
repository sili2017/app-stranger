# Copy this file to .env.prod (same directory) and fill in real values.
# .env.prod is gitignored — never commit it.
#
# Usage:
#   docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.prod.yml \
#     --env-file infra/docker/.env.prod up -d --build

# Shared password for all 9 Postgres roles (identity_profile, offer, ...). Isolation
# comes from separate databases/roles/containers, not from unique passwords — this
# is a test-stack simplification. Generate one with:
#   openssl rand -base64 24
DB_PASSWORD=

# Signing secret for the dev OIDC issuer (services/api-gateway/src/auth/dev-oidc-issuer.ts).
# This whole auth path is a dev-only stand-in (see docs/architecture/decisions.md
# ADQ-002a) — there's no real user data at risk — but still shouldn't be left blank.
DEV_OIDC_SECRET=
