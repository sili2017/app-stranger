# Copy this file to .env.cloud (same directory) and fill in real values.
# .env.cloud is gitignored — never commit it. Lives only on the Strato server.
#
# Usage:
#   docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.cloud.yml \
#     --env-file infra/docker/.env.cloud up -d

# Shared password for all 9 Postgres roles — same test-stack simplification as
# .env.prod.example. Generate one with:
#   openssl rand -base64 24
DB_PASSWORD=

# Signing secret for the dev OIDC issuer (services/api-gateway/src/auth/dev-oidc-issuer.ts).
# Dev-only auth stand-in (ADQ-002a) — still shouldn't be left blank.
DEV_OIDC_SECRET=

# The public hostname Caddy issues a Let's Encrypt cert for. With no domain of your
# own, use a free sslip.io hostname built from the server's static public IP, e.g.
# an IP of 85.215.12.34 becomes:
SITE_ADDRESS=85-215-12-34.sslip.io

# AWS S3 bucket for media/ID-document storage (services/media, ADQ-005 — already
# implemented in code, this is config only). Use an IAM user scoped to just this
# bucket's GetObject/PutObject/DeleteObject, never account-wide credentials.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Pre-built images pushed by .github/workflows/deploy.yml. Override only if you're
# testing a specific tag instead of :latest.
BACKEND_IMAGE=ghcr.io/sili2017/app-stranger-backend:latest
WEB_IMAGE=ghcr.io/sili2017/app-stranger-web:latest
