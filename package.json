{
  "name": "stranger-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Stranger platform monorepo: API gateway, domain services, and shared TypeScript packages.",
  "workspaces": [
    "services/*",
    "packages/ts-platform",
    "packages/test-fixtures"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "lint": "eslint \"services/*/src/**/*.ts\" \"packages/ts-platform/src/**/*.ts\" \"packages/test-fixtures/src/**/*.ts\"",
    "format": "prettier --check \"services/**/*.ts\" \"packages/**/*.ts\"",
    "format:write": "prettier --write \"services/**/*.ts\" \"packages/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  }
}
