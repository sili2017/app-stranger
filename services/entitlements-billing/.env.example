DATABASE_URL="postgresql://entitlements_billing:dev_only_password@localhost:5432/entitlements_billing?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3007

# ADQ-001/T123: unset (or "redis") keeps the dev pub/sub substitute; "kafka" switches
# to the real transport, reading KAFKA_BROKERS (comma-separated, default localhost:9092).
# scripts/startStop/start.sh sets both for the local stack automatically.
EVENT_BUS_DRIVER="kafka"
KAFKA_BROKERS="localhost:9092"

# ADQ-004/T124: unset (or anything other than "stripe") keeps the dev-only mock
# verifier; "stripe" switches purchases.service.ts/subscriptions.service.ts to real
# Stripe receipt verification and enables the /payment-webhook/stripe endpoint.
# STRIPE_SECRET_KEY is the platform API key (sk_test_.../sk_live_...); STRIPE_WEBHOOK_SECRET
# is the signing secret Stripe gives you for that specific webhook endpoint (whsec_...).
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Convergence T122/ADQ-002a: unset (or anything other than "oidc") keeps the dev-only
# x-dev-user-id header stand-in used by createAuthMiddleware; "oidc" switches to real
# JWT/JWKS bearer-token verification against OIDC_ISSUER_URL (OIDC_AUDIENCE optional,
# checked only when set). No real OIDC provider is configured yet (ADQ-002a still open
# on the specific vendor) — this stays "dev" until one is.
AUTH_PROVIDER="dev"
OIDC_ISSUER_URL=""
OIDC_AUDIENCE=""
