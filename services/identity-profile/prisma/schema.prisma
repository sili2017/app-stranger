generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Transactional outbox (constitution §5) — see packages/ts-platform/src/outbox/outbox.prisma.fragment
model OutboxEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique
  eventType        String
  aggregateId      String
  aggregateVersion Int
  correlationId    String
  causationId      String?
  producedBy       String
  schemaVersion    Int
  data             Json
  occurredAt       DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)

  @@index([publishedAt])
}

// --- Identity & Profile domain models (T030-T034) ---

enum AgeAssuranceStatus {
  self_declared
  liveness_passed
  liveness_flagged_pending_id
  id_verified
  id_rejected_appeal_pending
  restricted
}

enum AccountStatus {
  active
  disabled
}

/// Item 30/33: how this account was registered. `dev` is the pre-existing
/// x-dev-user-id stand-in (seed scripts, manual testing). `quick` is item 33's
/// name+date-of-birth-only signup — no email/password yet, just a device session;
/// `email`/`google`/`facebook`/`apple` all still apply once/if the account later adds
/// real credentials (see UserAccount.email/passwordHash — a `quick` account keeps
/// authProvider `quick` even after completing its profile with an email+password,
/// since that column records *how the account started*, not just its current
/// strongest credential; loginWithEmail only ever checks email+passwordHash directly).
enum AuthProviderKind {
  dev
  quick
  email
  google
  facebook
  apple
}

/// Highly Restricted: dateOfBirth never appears in an API response or event
/// (data-model.md Sensitive-Data Classification). passwordHash is Highly Restricted
/// for the same reason and never appears in a response either.
model UserAccount {
  id                 String             @id @default(uuid())
  dateOfBirth        DateTime           @db.Timestamptz(3)
  ageAssuranceStatus AgeAssuranceStatus @default(self_declared)
  accountStatus      AccountStatus      @default(active)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  /// Item 30.1: registration method. `email`+`passwordHash` are set for an `email`
  /// account; `oauthSubject` (the provider's own stable user id) is set for
  /// google/facebook/apple. Never both — a account is exactly one of the two.
  authProvider AuthProviderKind @default(dev)
  email        String?          @unique
  passwordHash String?
  oauthSubject String?

  /// Item 35: whether the address on file has actually been confirmed reachable — set
  /// via a one-time link (email) or a one-time code (phone). Resets to false any time
  /// the value itself changes, since a new address hasn't been proven yet.
  emailVerified Boolean @default(false)
  phone         String? @unique
  phoneVerified Boolean @default(false)

  publicProfile           PublicProfile?
  registeredAddress       RegisteredAddress?
  verificationCases       VerificationCase[]
  cityInterests           CityInterest[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerificationCodes  PhoneVerificationCode[]

  // A given provider's subject id maps to exactly one account. Nullable columns don't
  // collide under a Postgres unique index (NULLs are never equal to each other), so
  // this only constrains the email/google/facebook/apple rows that actually set it.
  @@unique([authProvider, oauthSubject])
}

/// Item 35: a one-time link's hash, sent to the address it's meant to prove control
/// of. tokenHash (not the raw token) is what's stored — matches passwordHash's own
/// never-store-the-real-secret rule — since anyone reading this table shouldn't be
/// able to complete verification on someone else's behalf.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  email     String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

/// Item 35: a one-time SMS code's hash. `attempts` caps guessing a short numeric code
/// (unlike the email link's own effectively-unguessable random token).
model PhoneVerificationCode {
  id        String   @id @default(uuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum ProfileVerificationStatus {
  unverified
  photo_verified
  id_verified
}

model PublicProfile {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  user                UserAccount               @relation(fields: [userId], references: [id])
  firstName           String
  photoAssetId        String?
  ageRangeLabel       String
  interests           String[]
  verificationStatus  ProfileVerificationStatus @default(unverified)
  languagePreference  String                    @default("en")
  // Controlled public: average + count only, never individual feedback text
  // (data-model.md Sensitive-Data Classification).
  publicRatingAverage Float?
  publicRatingCount   Int                       @default(0)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
}

model RegisteredAddress {
  id               String      @id @default(uuid())
  userId           String      @unique
  user             UserAccount @relation(fields: [userId], references: [id])
  city             String
  country          String
  // Nullable placeholder pending the city→timezone mapping decision (spec Open Question 18).
  calendarTimezone String?
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
}

enum VerificationKind {
  photo_liveness
  government_id
}

enum VerificationStatus {
  submitted
  passed
  flagged
  rejected
  appeal_pending
  appeal_upheld
  appeal_denied
}

model VerificationCase {
  id              String             @id @default(uuid())
  userId          String
  user            UserAccount        @relation(fields: [userId], references: [id])
  kind            VerificationKind
  status          VerificationStatus @default(submitted)
  // References Media by id only — never stores the file itself (data-model.md).
  evidenceAssetId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model CityInterest {
  id        String      @id @default(uuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  cityId    String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([userId, cityId])
  @@index([userId])
}

/// T109: separate, immutable audit-event stream distinct from ordinary application logs
/// (constitution §7) — every moderator/admin action (here: verification appeal
/// decisions) writes here.
model AuditLogEntry {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  subjectType String
  subjectId   String
  details     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@index([createdAt])
}
