generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Transactional outbox (constitution §5) — see packages/ts-platform/src/outbox/outbox.prisma.fragment
model OutboxEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique
  eventType        String
  aggregateId      String
  aggregateVersion Int
  correlationId    String
  causationId      String?
  producedBy       String
  schemaVersion    Int
  data             Json
  occurredAt       DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)

  @@index([publishedAt])
}

/// T8-followup: backs Identity & Profile's `photoAssetId` / `VerificationCase.
/// evidenceAssetId` (they reference Media by id only, never store the file — see that
/// schema's own comments). Dev-only local storage (ADQ-005 is still open); `storageKey`
/// is the LocalFilesystemStorageAdapter path, never returned to a client directly.
model Asset {
  id             String   @id @default(uuid())
  ownerUserId    String
  contentType    String
  byteSize       Int
  storageKey     String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerUserId])
}
